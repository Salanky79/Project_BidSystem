<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo1.AuctionDetailController"
           prefWidth="1100.0"
           prefHeight="900.0"
           style="-fx-background-color: rgba(0,0,0,0.4);">

    <!-- Main popup card -->
    <VBox prefWidth="1060.0"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 0;">

        <!-- Close button row -->
        <HBox alignment="TOP_RIGHT" style="-fx-padding: 12 12 0 12;">
            <Button text="X"
                    fx:id="closeBtn"
                    onAction="#handleClose"
                    prefWidth="36.0"
                    prefHeight="36.0"
                    style="-fx-background-color: #1a1a1a;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-border-radius: 50;
                           -fx-background-radius: 50;
                           -fx-cursor: hand;"/>
        </HBox>

        <!-- Main content: Left + Right -->
        <HBox spacing="32.0" style="-fx-padding: 0 32 24 32;" VBox.vgrow="ALWAYS">

            <!-- ===== LEFT PANEL ===== -->
            <VBox prefWidth="420.0" spacing="16.0">

                <!-- Image box with gold background -->
                <StackPane prefWidth="420.0" prefHeight="420.0"
                           style="-fx-background-color: #c9a84c;
                                  -fx-background-radius: 12;">
                    <!-- White inner frame -->
                    <StackPane prefWidth="340.0" prefHeight="360.0"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 4;">
                        <!-- Placeholder image area -->
                        <Label fx:id="itemImagePlaceholder"
                               text="🖼"
                               style="-fx-font-size: 80px;"/>
                        <!-- Swap with ImageView when image is available:
                        <ImageView fx:id="itemImage"
                                   fitWidth="320.0" fitHeight="340.0"
                                   preserveRatio="true"/>
                        -->
                    </StackPane>
                </StackPane>

                <!-- Listed By -->
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Listed By : "
                           style="-fx-font-size: 16px; -fx-text-fill: #555555;"/>
                    <Label fx:id="listedByLabel"
                           text="Myrle Oxnam"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                </HBox>

                <!-- Description -->
                <VBox spacing="6.0">
                    <Label text="Description :"
                           style="-fx-font-size: 16px; -fx-text-fill: #555555;"/>
                    <Label fx:id="descriptionLabel"
                           text="Kobe Bryant Game Worn Jersey From Final NBA Opening Day 2015-2016 Season"
                           style="-fx-font-size: 15px; -fx-text-fill: #333333; -fx-wrap-text: true;"
                           prefWidth="400.0"/>
                </VBox>

            </VBox>

            <!-- ===== RIGHT PANEL ===== -->
            <VBox prefWidth="560.0" spacing="14.0">

                <!-- Item title -->
                <Label fx:id="itemTitleLabel"
                       text="Adidas"
                       style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a; -fx-font-family: Georgia;"/>

                <!-- Status + Category badges -->
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label fx:id="statusLabel"
                           text="Active"
                           style="-fx-background-color: #1a1a1a;
                                  -fx-text-fill: white;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 6 20 6 20;
                                  -fx-background-radius: 20;"/>
                    <Label fx:id="categoryLabel"
                           text="Other"
                           style="-fx-background-color: #c9a84c;
                                  -fx-text-fill: white;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 6 20 6 20;
                                  -fx-background-radius: 20;"/>
                </HBox>

                <!-- Price / Bids / Dates -->
                <VBox spacing="10.0" style="-fx-padding: 6 0 6 0;">

                    <HBox spacing="24.0" alignment="CENTER_LEFT">
                        <Label text="Current Price"
                               prefWidth="120.0" style="-fx-font-size: 15px; -fx-text-fill: #555555; "/>
                        <Label fx:id="currentPriceLabel"
                               text="140000.0"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    </HBox>

                    <HBox spacing="24.0" alignment="CENTER_LEFT">
                        <Label text="Total Bids :"
                               prefWidth="120.0" style="-fx-font-size: 15px; -fx-text-fill: #555555; "/>
                        <Label fx:id="totalBidsLabel"
                               text="0"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    </HBox>

                    <HBox spacing="24.0" alignment="CENTER_LEFT">
                        <Label text="Started On :"
                               prefWidth="120.0" style="-fx-font-size: 15px; -fx-text-fill: #555555; "/>
                        <Label fx:id="startDateLabel"
                               text="23/12/2022 00:08"
                               style="-fx-font-size: 15px; -fx-text-fill: #1a1a1a;"/>
                    </HBox>

                    <HBox spacing="24.0" alignment="CENTER_LEFT">
                        <Label text="End On :"
                               prefWidth="120.0" style="-fx-font-size: 15px; -fx-text-fill: #555555; "/>
                        <Label fx:id="endDateLabel"
                               text="01/02/2023 00:08"
                               style="-fx-font-size: 15px; -fx-text-fill: #1a1a1a;"/>
                    </HBox>

                </VBox>

                <Separator/>

                <!-- Place bid row -->
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <TextField fx:id="bidField"
                               promptText="Place Bid"
                               prefHeight="44.0"
                               prefWidth="320.0"
                               style="-fx-background-color: white;
                                      -fx-border-color: #1a1a1a;
                                      -fx-border-width: 1.5;
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-font-size: 14px;
                                      -fx-padding: 0 14 0 14;"/>
                    <Button text="Place"
                            fx:id="placeBidBtn"

                            prefWidth="90.0"
                            prefHeight="44.0"
                            style="-fx-background-color: #c9a84c;
                                   -fx-text-fill: white;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-border-radius: 8;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>
                </HBox>

                <!-- Validation label -->
                <Label fx:id="validationLabel"
                       text=""
                       visible="false"
                       style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-font-style: italic;"/>

                <!-- Comments section -->
                <Label text="Comments"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

                <!-- Comment list -->
                <ScrollPane fx:id="commentScrollPane"
                            prefHeight="220.0"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">

                    <VBox fx:id="commentList"
                          spacing="0.0"
                          style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-padding: 0;">

                        <!-- Comment item 1 -->
                        <VBox style="-fx-padding: 12 16 12 16; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Ahmed Abdullah"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #c9a84c;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="23/12/2022 00:36"
                                       style="-fx-font-size: 12px; -fx-text-fill: #aaaaaa;"/>
                            </HBox>
                            <Label text="Nice man"
                                   style="-fx-font-size: 13px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                        <!-- Comment item 2 -->
                        <VBox style="-fx-padding: 12 16 12 16; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Ahmed Abdullah"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #c9a84c;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="23/12/2022 00:36"
                                       style="-fx-font-size: 12px; -fx-text-fill: #aaaaaa;"/>
                            </HBox>
                            <Label text="But i dont like basket ball"
                                   style="-fx-font-size: 13px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                        <!-- Comment item 3 -->
                        <VBox style="-fx-padding: 12 16 12 16; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Ahmed Abdullah"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #c9a84c;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="23/12/2022 00:36"
                                       style="-fx-font-size: 12px; -fx-text-fill: #aaaaaa;"/>
                            </HBox>
                            <Label text="If this was ronaldo shirt then i'll buy it"
                                   style="-fx-font-size: 13px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                        <!-- Comment item 4 -->
                        <VBox style="-fx-padding: 12 16 12 16;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Ahmed Abdullah"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #c9a84c;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="23/12/2022 00:37"
                                       style="-fx-font-size: 12px; -fx-text-fill: #aaaaaa;"/>
                            </HBox>
                            <Label text="Crazy Expensive"
                                   style="-fx-font-size: 13px; -fx-text-fill: white; -fx-wrap-text: true;"/>
                        </VBox>

                    </VBox>
                </ScrollPane>

                <!-- New comment input -->
                <StackPane style="-fx-padding: 8 0 0 0;">
                    <TextField fx:id="commentField"
                               prefHeight="52.0"
                               style="-fx-background-color: white;
                                      -fx-border-color: #1a1a1a;
                                      -fx-border-width: 1.5;
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-font-size: 14px;
                                      -fx-padding: 0 100 0 14;"/>
                    <Label text="Comment"
                           style="-fx-font-size: 11px; -fx-text-fill: #888888; -fx-background-color: white; -fx-padding: 0 4 0 4;"
                           StackPane.alignment="TOP_LEFT"
                           translateX="14.0"
                           translateY="-1.0"/>
                    <Button text="Post"
                            fx:id="postCommentBtn"
                            onAction="#handlePostComment"
                            prefWidth="72.0"
                            prefHeight="38.0"
                            style="-fx-background-color: #c9a84c;
                                   -fx-text-fill: white;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-border-radius: 8;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"
                            StackPane.alignment="CENTER_RIGHT"
                            translateX="-8.0"/>
                </StackPane>

            </VBox>
        </HBox>
    </VBox>

</StackPane>
