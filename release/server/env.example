# ==========================================
# CẤU HÌNH SERVER
# Copy file này thành ".env" và điền thông tin thực tế
# ==========================================

# 1. Cấu hình Port chạy Server (Mặc định 8080)
PORT=8080

# 2. Cấu hình Database MySQL (Aiven hoặc Local)
DB_URL=jdbc:mysql://<host>:<port>/<dbname>?useSSL=true
DB_USER=your_db_username
DB_PASS=your_db_password
DB_POOL_SIZE=20

# 3. Cấu hình Cloudinary (Lưu trữ ảnh sản phẩm)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
