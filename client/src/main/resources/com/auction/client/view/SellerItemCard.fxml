<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox fx:id="cardRoot" prefHeight="160.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e8e8e8; -fx-border-width: 1; -fx-cursor: hand;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.SellerItemCardController">

    <StackPane fx:id="itemcard" mouseTransparent="true" onMouseClicked="#handleCardClick" prefHeight="160.0" prefWidth="160.0" style="-fx-background-color: #d0d0d0; -fx-background-radius: 12 0 0 12;">
        <Label fx:id="iconLabel" mouseTransparent="true" style="-fx-font-size: 40px;" text="🖼" />
        <Label fx:id="statusLabel" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 3 8 3 8; -fx-background-radius: 4;" text="Popular Now" translateX="8.0" translateY="8.0" StackPane.alignment="TOP_LEFT" />
    </StackPane>

    <VBox spacing="6.0" style="-fx-padding: 14 14 14 14;" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
        <HBox alignment="TOP_RIGHT" spacing="8">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="deleteButton" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 10 3 10; -fx-background-radius: 20; -fx-cursor: hand;" text="🗑 Delete" visible="false" managed="false"/>
            <Label fx:id="categoryLabel" style="-fx-background-color: #f0a500; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 10 3 10; -fx-background-radius: 20;" text="Category" />
        </HBox>
        <Label fx:id="nameLabel" mouseTransparent="true" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a; -fx-wrap-text: true;" text="Item Name" />
        <Label fx:id="priceLabel" style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="0 USD" />
        <Label fx:id="bidsLabel" style="-fx-font-size: 13px; -fx-text-fill: #777777;" text="0 bids" />
        <Label fx:id="timeLabel" style="-fx-font-size: 12px; -fx-text-fill: #555555;" text="Ending In : --" />
    </VBox>
</HBox>
