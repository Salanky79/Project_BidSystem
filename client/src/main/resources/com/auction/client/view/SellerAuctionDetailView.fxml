<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="600.0" prefWidth="1050.0"
            style="-fx-background: #0A0A0A; -fx-background-color: #0A0A0A;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.SellerAuctionDetailController">

    <VBox spacing="0" style="-fx-background-color: #0A0A0A; -fx-padding: 0;">

        <!-- ═══════════════════════════════════════════════ -->
        <!-- HEADER                                          -->
        <!-- ═══════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #111111; -fx-padding: 16 24 16 24;
                     -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <!-- Product Title -->
                <Label fx:id="productTitleLabel"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                       text="Kobe Bryant Game Worn Jersey" />

                <!-- Status tags: Active (filled gold), Other (outline grey) — Follow removed for seller -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37;
                                   -fx-border-radius: 20; -fx-background-radius: 20;
                                   -fx-text-fill: #000000; -fx-font-size: 12px;
                                   -fx-font-weight: bold; -fx-padding: 5 16 5 16; -fx-cursor: hand;"
                            text="Active" />
                    <Button style="-fx-background-color: transparent; -fx-border-color: #555555;
                                   -fx-border-radius: 20; -fx-background-radius: 20;
                                   -fx-text-fill: #888888; -fx-font-size: 12px;
                                   -fx-padding: 5 16 5 16; -fx-cursor: hand;"
                            text="Other" />
                </HBox>
            </VBox>

            <!-- Close Button -->
            <Button fx:id="closeButton"
                    style="-fx-background-color: #2A2A2A; -fx-border-color: #444444;
                           -fx-border-radius: 50; -fx-background-radius: 50;
                           -fx-text-fill: #CCCCCC; -fx-font-size: 15px; -fx-font-weight: bold;
                           -fx-min-width: 40; -fx-min-height: 40;
                           -fx-max-width: 40; -fx-max-height: 40; -fx-cursor: hand;"
                    text="✕" />
        </HBox>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: Left + Right columns              -->
        <!-- ═══════════════════════════════════════════════ -->
        <HBox spacing="0" style="-fx-background-color: #0A0A0A;">

            <!-- ─────────────────────────────────────────── -->
            <!-- LEFT COLUMN                                 -->
            <!-- ─────────────────────────────────────────── -->
            <VBox spacing="0" style="-fx-padding: 20 16 20 20; -fx-background-color: #0A0A0A;"
                  HBox.hgrow="ALWAYS">

                <!-- ══ PRICE HISTORY CARD (retained as-is) ══ -->
                <VBox spacing="12"
                      style="-fx-background-color: #111111; -fx-padding: 20;
                             -fx-background-radius: 10; -fx-border-radius: 10;
                             -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                               text="PRICE HISTORY" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <LineChart fx:id="priceHistoryChart" animated="false" legendVisible="false"
                               prefHeight="230"
                               style="-fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis fx:id="chartXAxis" label="Time"
                                          style="-fx-tick-label-fill: #888888; -fx-label-fill: #888888;
                                                 -fx-tick-label-font-size: 10px;" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="chartYAxis" label="Price (VND)"
                                        style="-fx-tick-label-fill: #888888; -fx-label-fill: #888888;
                                               -fx-tick-label-font-size: 10px;" />
                        </yAxis>
                    </LineChart>
                </VBox>

                <Region prefHeight="16" />

                <!-- ══ ORDER & FULFILLMENT STATUS CARD ══ -->
                <VBox spacing="12"
                      style="-fx-background-color: #111111; -fx-padding: 20;
                             -fx-background-radius: 10; -fx-border-radius: 10;
                             -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                           text="ORDER &amp; FULFILLMENT STATUS" />
                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Winner Identified -->
                    <HBox alignment="CENTER_LEFT" spacing="0"
                          style="-fx-background-color: #1A1A1A; -fx-padding: 10 12 10 12;
                                 -fx-background-radius: 6;">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;"
                                   text="WINNER IDENTIFIED" />
                            <Label fx:id="winnerIdLabel"
                                   style="-fx-text-fill: #D4AF37; -fx-font-size: 14px;
                                          -fx-font-weight: bold;"
                                   text="User A (ID: #10482)" />
                        </VBox>
                        <Label style="-fx-text-fill: #4CAF50; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-background-color: #1B3B1B;
                                      -fx-background-radius: 4; -fx-padding: 3 8 3 8;"
                               text="✔  CONFIRMED" />
                    </HBox>

                    <!-- Payment Status -->
                    <HBox alignment="CENTER_LEFT" spacing="0"
                          style="-fx-background-color: #1A1A1A; -fx-padding: 10 12 10 12;
                                 -fx-background-radius: 6;">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;"
                                   text="PAYMENT STATUS" />
                            <Label fx:id="paymentStatusLabel"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 13px;"
                                   text="Awaiting payment confirmation" />
                        </VBox>
                        <Label fx:id="paymentBadgeLabel"
                               style="-fx-text-fill: #FFD700; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-background-color: #3B3000;
                                      -fx-background-radius: 4; -fx-padding: 3 8 3 8;"
                               text="⏳  PENDING" />
                    </HBox>

                    <!-- Shipping Info -->
                    <HBox alignment="CENTER_LEFT" spacing="0"
                          style="-fx-background-color: #1A1A1A; -fx-padding: 10 12 10 12;
                                 -fx-background-radius: 6;">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;"
                                   text="SHIPPING INFO" />
                            <Label fx:id="shippingInfoLabel"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 13px;"
                                   text="Not yet dispatched" wrapText="true" />
                        </VBox>
                        <Label fx:id="shippingBadgeLabel"
                               style="-fx-text-fill: #AAAAAA; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-background-color: #252525;
                                      -fx-background-radius: 4; -fx-padding: 3 8 3 8;"
                               text="—  NOT SHIPPED" />
                    </HBox>

                    <!-- Feedback -->
                    <HBox alignment="CENTER_LEFT" spacing="0"
                          style="-fx-background-color: #1A1A1A; -fx-padding: 10 12 10 12;
                                 -fx-background-radius: 6;">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;"
                                   text="FEEDBACK" />
                            <Label fx:id="feedbackStatusLabel"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 13px;"
                                   text="No feedback received yet" />
                        </VBox>
                        <Label fx:id="feedbackBadgeLabel"
                               style="-fx-text-fill: #AAAAAA; -fx-font-size: 11px;
                                      -fx-font-weight: bold; -fx-background-color: #252525;
                                      -fx-background-radius: 4; -fx-padding: 3 8 3 8;"
                               text="—  NONE" />
                    </HBox>

                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button fx:id="contactWinnerButton"
                                style="-fx-background-color: transparent; -fx-border-color: #D4AF37;
                                       -fx-border-radius: 6; -fx-background-radius: 6;
                                       -fx-text-fill: #D4AF37; -fx-font-weight: bold;
                                       -fx-font-size: 12px; -fx-padding: 9 18 9 18; -fx-cursor: hand;"
                                text="✉  CONTACT WINNER" />
                        <Button fx:id="generateInvoiceButton"
                                style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37;
                                       -fx-border-radius: 6; -fx-background-radius: 6;
                                       -fx-text-fill: #000000; -fx-font-weight: bold;
                                       -fx-font-size: 12px; -fx-padding: 9 18 9 18; -fx-cursor: hand;"
                                text="🧾  GENERATE INVOICE" />
                    </HBox>

                </VBox>

            </VBox>

            <!-- ─────────────────────────────────────────── -->
            <!-- RIGHT COLUMN                                -->
            <!-- ─────────────────────────────────────────── -->
            <VBox prefWidth="380" spacing="0"
                  style="-fx-padding: 20 20 20 4; -fx-background-color: #0A0A0A;">

                <!-- ══ AUCTION KEY STATS CARD (gold border) ══ -->
                <VBox spacing="14"
                      style="-fx-background-color: #111111; -fx-padding: 20;
                             -fx-background-radius: 10; -fx-border-radius: 10;
                             -fx-border-color: #D4AF37; -fx-border-width: 1;">

                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;"
                           text="AUCTION KEY STATS" />
                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Current High Bid (large, gold) -->
                    <VBox spacing="2">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;"
                               text="Current High Bid" />
                        <Label fx:id="currentHighBidLabel"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;"
                               text="140,000 VND" />
                    </VBox>

                    <!-- Total Bids -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 18px;" text="🔨" />
                        <VBox spacing="1">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;"
                                   text="Total Bids" />
                            <Label fx:id="totalBidsLabel"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px;
                                          -fx-font-weight: bold;"
                                   text="0" />
                        </VBox>
                    </HBox>

                    <!-- Start / End / Ends In -->
                    <VBox spacing="8"
                          style="-fx-background-color: #1A1A1A; -fx-padding: 12;
                                 -fx-background-radius: 8;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 12px;
                                          -fx-min-width: 72;"
                                   text="▶  Start:" />
                            <Label fx:id="startTimeLabel"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;"
                                   text="12/04/2026 10:00" />
                        </HBox>
                        <Separator style="-fx-background-color: #333333; -fx-opacity: 1;" />
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 12px;
                                          -fx-min-width: 72;"
                                   text="■  End:" />
                            <Label fx:id="endTimeLabel"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;"
                                   text="14/04/2026 10:00" />
                        </HBox>
                        <Separator style="-fx-background-color: #333333; -fx-opacity: 1;" />
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 12px;
                                          -fx-min-width: 72;"
                                   text="⏰  Ends in:" />
                            <Label fx:id="endsInLabel"
                                   style="-fx-text-fill: #FFD700; -fx-font-size: 14px;
                                          -fx-font-weight: bold;"
                                   text="2d 14h 30m" />
                        </HBox>
                    </VBox>

                </VBox>

                <Region prefHeight="14" />

                <!-- ══ AUCTION CONTROL PANEL CARD ══ -->
                <VBox spacing="14"
                      style="-fx-background-color: #111111; -fx-padding: 20;
                             -fx-background-radius: 10; -fx-border-radius: 10;
                             -fx-border-color: #3A1A1A; -fx-border-width: 1;">

                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                           text="AUCTION CONTROL PANEL" />
                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Pause / Cancel row -->
                    <HBox spacing="10">
                        <Button fx:id="pauseAuctionButton"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: transparent;
                                       -fx-border-color: #B32626; -fx-border-width: 1;
                                       -fx-border-radius: 6; -fx-background-radius: 6;
                                       -fx-text-fill: #E57373; -fx-font-weight: bold;
                                       -fx-font-size: 12px; -fx-padding: 10 12 10 12;
                                       -fx-cursor: hand;"
                                text="⏸  Pause Auction" />
                        <Button fx:id="cancelAuctionButton"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: #B32626; -fx-border-color: #B32626;
                                       -fx-border-radius: 6; -fx-background-radius: 6;
                                       -fx-text-fill: #FFFFFF; -fx-font-weight: bold;
                                       -fx-font-size: 12px; -fx-padding: 10 12 10 12;
                                       -fx-cursor: hand;"
                                text="✕  Cancel Auction" />
                    </HBox>

                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Extend End Time row -->
                    <VBox spacing="6">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;
                                      -fx-font-weight: bold;"
                               text="EXTEND END TIME" />
                        <HBox spacing="8" alignment="CENTER">
                            <TextField fx:id="extendEndTimeField"
                                       promptText="e.g. 2026-05-01 18:00"
                                       style="-fx-background-color: #1E1E1E;
                                              -fx-border-color: #3A3A3A;
                                              -fx-border-radius: 6; -fx-background-radius: 6;
                                              -fx-text-fill: #FFFFFF;
                                              -fx-prompt-text-fill: #555555;
                                              -fx-font-size: 12px; -fx-padding: 8 10 8 10;"
                                       HBox.hgrow="ALWAYS" />
                            <Button fx:id="saveExtendTimeButton"
                                    style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-text-fill: #000000; -fx-font-weight: bold;
                                           -fx-font-size: 12px; -fx-padding: 8 14 8 14;
                                           -fx-cursor: hand;"
                                    text="Save" />
                        </HBox>
                    </VBox>

                    <!-- Set Bid Step row -->
                    <VBox spacing="6">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;
                                      -fx-font-weight: bold;"
                               text="SET BID STEP (VND)" />
                        <HBox spacing="8" alignment="CENTER">
                            <TextField fx:id="bidStepField"
                                       promptText="e.g. 5,000"
                                       style="-fx-background-color: #1E1E1E;
                                              -fx-border-color: #3A3A3A;
                                              -fx-border-radius: 6; -fx-background-radius: 6;
                                              -fx-text-fill: #FFFFFF;
                                              -fx-prompt-text-fill: #555555;
                                              -fx-font-size: 12px; -fx-padding: 8 10 8 10;"
                                       HBox.hgrow="ALWAYS" />
                            <Button fx:id="saveBidStepButton"
                                    style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37;
                                           -fx-border-radius: 6; -fx-background-radius: 6;
                                           -fx-text-fill: #000000; -fx-font-weight: bold;
                                           -fx-font-size: 12px; -fx-padding: 8 14 8 14;
                                           -fx-cursor: hand;"
                                    text="Save" />
                        </HBox>
                    </VBox>

                </VBox>

                <Region prefHeight="14" />

                <!-- ══ BIDDER MANAGEMENT CARD ══ -->
                <VBox spacing="12"
                      style="-fx-background-color: #111111; -fx-padding: 20;
                             -fx-background-radius: 10; -fx-border-radius: 10;
                             -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                           text="BIDDER MANAGEMENT" />
                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Each row template note: populated dynamically by controller via
                         a custom ListCell. The ListView below holds BidderEntry model objects.
                         Each cell renders: avatar icon | name + rating + status tag |
                         [View Profile] [Ban Bidder] buttons. -->
                    <ListView fx:id="bidderListView"
                              prefHeight="260"
                              style="-fx-background-color: transparent;
                                     -fx-border-color: transparent;
                                     -fx-padding: 0;" />



                </VBox>

            </VBox>
            <!-- end RIGHT COLUMN -->

        </HBox>
        <!-- end MAIN CONTENT -->

        <!-- ═══════════════════════════════════════════════ -->
        <!-- COMMENT MANAGEMENT SECTION                      -->
        <!-- ═══════════════════════════════════════════════ -->
        <VBox spacing="14"
              style="-fx-background-color: #0D0D0D; -fx-padding: 20 20 24 20;
                     -fx-border-color: #222222; -fx-border-width: 1 0 0 0;">

            <!-- Header: label + Newest/Oldest sort -->
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                       text="COMMENT MANAGEMENT" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="commentSortBox"
                          style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A;
                                 -fx-border-radius: 6; -fx-background-radius: 6;
                                 -fx-text-fill: #CCCCCC; -fx-font-size: 12px;"
                          value="Newest">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Newest" />
                            <String fx:value="Oldest" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <Separator style="-fx-background-color: #252525; -fx-opacity: 1;" />

            <!-- Dynamic ListView (filled by controller) -->
            <ListView fx:id="commentsListView" prefHeight="180"
                      style="-fx-background-color: transparent; -fx-border-color: transparent;
                             -fx-padding: 0;" />

            <!-- Official seller reply input + POST -->
            <HBox alignment="CENTER" spacing="8" style="-fx-padding: 4 0 0 0;">
                <TextField fx:id="commentInputField"
                           promptText="Post an official seller reply..."
                           style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A;
                                  -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #555555;
                                  -fx-font-size: 13px; -fx-padding: 10 12 10 12;"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="postCommentButton"
                        style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37;
                               -fx-border-radius: 6; -fx-background-radius: 6;
                               -fx-text-fill: #000000; -fx-font-weight: bold;
                               -fx-font-size: 13px; -fx-padding: 10 20 10 20; -fx-cursor: hand;"
                        text="POST" />
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>
