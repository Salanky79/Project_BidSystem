<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.HomeController">
    <VBox fx:id="Content" spacing="16.0" style="-fx-background-color: #f0f0f0; -fx-padding: 16 20 16 20;">

        <!-- Filter bar -->
        <HBox fx:id="filterBar" alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="btnAll" onAction="#handleFilterAll" maxWidth="1.7976931348623157E308" prefHeight="38.0"
                    prefWidth="70.0"
                    style="-fx-background-color: #1a1a1a; -fx-text-fill: white;   -fx-font-size: 13px; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"
                    text="All" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAntique" onAction="#handleFilterAntique" maxWidth="1.7976931348623157E308"
                    prefHeight="38.0" prefWidth="85.0"
                    style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-font-size: 13px; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"
                    text="Antique" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnArt" onAction="#handleFilterArt" maxWidth="1.7976931348623157E308"
                    prefHeight="38.0" prefWidth="85.0"
                    style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-font-size: 13px; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"
                    text="Art" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnElectronic" onAction="#handleFilterElectronic" maxWidth="1.7976931348623157E308" prefHeight="38.0"
                    prefWidth="75.0"
                    style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-font-size: 13px; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"
                    text="Electronic" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnJewelry" onAction="#handleFilterJewelry" maxWidth="1.7976931348623157E308"
                    prefHeight="38.0" prefWidth="85.0"
                    style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-font-size: 13px; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"
                    text="Jewelry" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRealEstate" onAction="#handleFilterRealEstate" maxWidth="1.7976931348623157E308" prefHeight="38.0"
                    prefWidth="85.0"
                    style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-font-size: 13px; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"
                    text="Real Estate" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVehicle" onAction="#handleFilterVehicle" maxWidth="1.7976931348623157E308" prefHeight="38.0"
                    prefWidth="80.0"
                    style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-font-size: 13px; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"
                    text="Vehicle" HBox.hgrow="ALWAYS"/>
            <Button maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="100.0"
                    style="-fx-background-color: #f0a500; -fx-text-fill: #1a1a1a; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"
                    text="Sort By" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- ScrollPane with auction grid -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                    VBox.vgrow="ALWAYS">

            <GridPane fx:id="auctionGrid" hgap="16.0" style="-fx-padding: 4 4 4 4;" vgap="16.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0"/>
                    <ColumnConstraints percentWidth="50.0"/>
                </columnConstraints>


            </GridPane>
        </ScrollPane>

    </VBox>
</ScrollPane>
