<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="600.0" prefWidth="950.0" style="-fx-background: #0A0A0A; -fx-background-color: #0A0A0A;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctionDetailController">

    <VBox style="-fx-background-color: #0A0A0A; -fx-padding: 0;">

        <!-- ═══════════════════════════════════════════════ -->
        <!-- HEADER                                          -->
        <!-- ═══════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #111111; -fx-padding: 16 24 16 24; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <!-- Product Title (fixed from "Adidas" to correct name) -->
                <Label fx:id="productTitleLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" text="Kobe Bryant Game Worn Jersey" />

                <!-- Tag Buttons: Follow (outline gold), Active (filled gold), Other (outline grey) -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="followButton" style="-fx-background-color: transparent; -fx-border-color: #D4AF37; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #D4AF37; -fx-font-size: 12px; -fx-padding: 5 16 5 16; -fx-cursor: hand;" text="+ Follow" />
                    <Button style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 16 5 16; -fx-cursor: hand;" text="Active" />
                    <Button style="-fx-background-color: transparent; -fx-border-color: #555555; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #888888; -fx-font-size: 12px; -fx-padding: 5 16 5 16; -fx-cursor: hand;" text="Other" />
                </HBox>
            </VBox>

            <!-- Close Button (larger hit area) -->
            <Button fx:id="closeButton" style="-fx-background-color: #2A2A2A; -fx-border-color: #444444; -fx-border-radius: 50; -fx-background-radius: 50; -fx-text-fill: #CCCCCC; -fx-font-size: 15px; -fx-font-weight: bold; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40; -fx-cursor: hand;" text="✕" />
        </HBox>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: Left + Right columns              -->
        <!-- ═══════════════════════════════════════════════ -->
        <HBox style="-fx-background-color: #0A0A0A;">

            <!-- ─────────────────────────────────────────── -->
            <!-- LEFT COLUMN                                 -->
            <!-- ─────────────────────────────────────────── -->
            <VBox style="-fx-padding: 20 16 20 20; -fx-background-color: #0A0A0A;" HBox.hgrow="ALWAYS">

                <!-- PRICE HISTORY CARD -->
                <VBox spacing="12" style="-fx-background-color: #111111; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" text="PRICE HISTORY" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- LineChart: axes labelled with VND unit -->
                    <LineChart fx:id="priceHistoryChart" animated="false" legendVisible="false" prefHeight="230" style="-fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis fx:id="chartXAxis" label="Time" style="-fx-tick-label-fill: #888888; -fx-label-fill: #888888; -fx-tick-label-font-size: 10px;" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="chartYAxis" label="Price (VND)" style="-fx-tick-label-fill: #888888; -fx-label-fill: #888888; -fx-tick-label-font-size: 10px;" />
                        </yAxis>
                    </LineChart>
                </VBox>

                <Region prefHeight="16" />

                <!-- SELLER INFORMATION CARD -->
                <VBox spacing="12" style="-fx-background-color: #111111; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" text="Seller Information" />
                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Listed By -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 13px;" text="Listed By:" />
                        <Label fx:id="sellerNameLabel" style="-fx-text-fill: #D4AF37; -fx-font-weight: bold; -fx-font-size: 13px; -fx-underline: true; -fx-cursor: hand;" text="Myrle Oxnam" />
                    </HBox>

                    <!-- Star rating (icon stars) + Contact button (outline gold) -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #D4AF37; -fx-font-size: 15px;" text="★★★★☆" />
                        <Label fx:id="ratingLabel" style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px;" text="4.6" />
                        <Label style="-fx-text-fill: #333333; -fx-font-size: 13px;" text="|" />
                        <Button style="-fx-background-color: transparent; -fx-border-color: #D4AF37; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #D4AF37; -fx-font-size: 12px; -fx-padding: 4 12 4 12; -fx-cursor: hand;" text="✉  Contact" />
                    </HBox>

                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Description with "Read more" -->
                    <VBox spacing="6">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 12px;" text="Description:" />
                        <Label fx:id="descriptionLabel" style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-line-spacing: 3;" text="Kobe Bryant Game Worn Jersey From Final NBA Opening Day 2015-2016 Season" wrapText="true" />
                        <Label style="-fx-text-fill: #D4AF37; -fx-font-size: 12px; -fx-cursor: hand;" text="Read more..." />
                    </VBox>
                </VBox>

            </VBox>

            <!-- ─────────────────────────────────────────── -->
            <!-- RIGHT COLUMN                                -->
            <!-- ─────────────────────────────────────────── -->
            <VBox prefWidth="360" style="-fx-padding: 20 20 20 4; -fx-background-color: #0A0A0A;">

                <!-- AUCTION KEY STATS CARD (gold border) -->
                <VBox spacing="14" style="-fx-background-color: #111111; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #D4AF37; -fx-border-width: 1;">

                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" text="AUCTION KEY STATS" />
                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;" />

                    <!-- Current Price (large, gold) -->
                    <VBox spacing="2">
                        <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;" text="Current Price" />
                        <Label fx:id="currentPriceLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;" text="140,000 VND" />
                    </VBox>

                    <!-- Total Bids (hammer icon + own row) -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 18px;" text="🔨" />
                        <VBox spacing="1">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 11px;" text="Total Bids" />
                            <Label fx:id="totalBidsLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                        </VBox>
                    </HBox>

                    <!-- Start / End / Ends In (separated, readable) -->
                    <VBox spacing="8" style="-fx-background-color: #1A1A1A; -fx-padding: 12; -fx-background-radius: 8;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-min-width: 72;" text="▶  Start:" />
                            <Label fx:id="startTimeLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;" text="12/04/2026 10:00" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-min-width: 72;" text="■  End:" />
                            <Label fx:id="endTimeLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;" text="14/04/2026 10:00" />
                        </HBox>
                        <Separator style="-fx-background-color: #333333; -fx-opacity: 1;" />
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-min-width: 72;" text="⏰  Ends in:" />
                            <Label fx:id="endsInLabel" style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold;" text="2d 14h 30m" />
                        </HBox>
                    </VBox>
                </VBox>

                <Region prefHeight="14" />

                <!-- PRODUCT IMAGE (gold 2px border, shadow via background) -->
                <VBox alignment="CENTER" style="-fx-background-color: #111111; -fx-padding: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #D4AF37; -fx-border-width: 2; -fx-min-height: 320; -fx-min-width: 320;">
                    <Label fx:id="productIconLabel" style="-fx-font-size: 150px;" text="📦" />
                </VBox>

                <Region prefHeight="14" />

                <!-- PLACE BID CARD -->
                <VBox spacing="10" style="-fx-background-color: #111111; -fx-padding: 18; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;" text="Place Your Bid" />

                    <!-- Input ~70%  |  Button ~30%, text BLACK for WCAG contrast -->
                    <HBox alignment="CENTER" spacing="8">
                        <TextField fx:id="bidInputField" promptText="Enter bid amount..." style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 10 12 10 12;" HBox.hgrow="ALWAYS" />
                        <Button fx:id="placeBidButton" style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20 10 20; -fx-cursor: hand;" text="PLACE" />
                    </HBox>

                    <!-- Minimum bid hint -->
                    <Label fx:id="minBidLabel" style="-fx-text-fill: #888888; -fx-font-size: 11px;" text="Minimum bid: 140,500 VND" />
                </VBox>

                <Region prefHeight="14"/>

                <!-- AUTO BID CARD -->
                <VBox spacing="10"
                      style="-fx-background-color: #111111; -fx-padding: 18; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <Label text="Auto Bid"
                           style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                    <TextField fx:id="autoBidMaxInputField" promptText="Max bid..."
                               style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 10 12 10 12;"/>

                    <TextField fx:id="autoBidIncrementInputField" promptText="Increment..."
                               style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 10 12 10 12;"/>

                    <HBox spacing="8" alignment="CENTER">
                        <Button fx:id="enableAutoBidButton" text="ENABLE"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 12 10 12; -fx-cursor: hand;"/>
                        <Button fx:id="cancelAutoBidButton" text="CANCEL"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                disable="true"
                                style="-fx-background-color: transparent; -fx-border-color: #666666; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #CCCCCC; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 12 10 12; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="autoBidStatusLabel" text="Auto-bid is off"
                           style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
                </VBox>

            </VBox>
        </HBox>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- COMMENTS SECTION                                -->
        <!-- ═══════════════════════════════════════════════ -->
        <VBox spacing="14" style="-fx-background-color: #0D0D0D; -fx-padding: 20 20 24 20; -fx-border-color: #222222; -fx-border-width: 1 0 0 0;">

            <!-- Header: label + Newest/Oldest sort -->
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" text="COMMENTS" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="commentSortBox" style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #CCCCCC; -fx-font-size: 12px;" value="Newest">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Newest" />
                            <String fx:value="Oldest" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <Separator style="-fx-background-color: #252525; -fx-opacity: 1;" />

            <!-- Dynamic ListView (filled by controller) -->
            <ListView fx:id="commentsListView" prefHeight="180" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;" />


            <!-- Comment input + POST (same style as Place Bid) -->
            <HBox alignment="CENTER" spacing="8" style="-fx-padding: 4 0 0 0;">
                <TextField fx:id="commentInputField" promptText="Write a comment..." style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 10 12 10 12;" HBox.hgrow="ALWAYS" />
                <Button fx:id="postCommentButton" style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20 10 20; -fx-cursor: hand;" text="POST" />
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>
