<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.collections.*?>

<?import java.lang.String?>
<ScrollPane fitToWidth="true" style="-fx-background: #0A0A0A; -fx-background-color: #0A0A0A;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionDetailController">

    <VBox spacing="0" style="-fx-background-color: #0A0A0A; -fx-padding: 0;">

        <!-- ═══════════════════════════════════════════════ -->
        <!-- HEADER                                          -->
        <!-- ═══════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #111111; -fx-padding: 16 24 16 24; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">

            <VBox HBox.hgrow="ALWAYS" spacing="8">
                <!-- Product Title (fixed from "Adidas" to correct name) -->
                <Label fx:id="productTitleLabel" text="Kobe Bryant Game Worn Jersey"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>

                <!-- Tag Buttons: Follow (outline gold), Active (filled gold), Other (outline grey) -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="followButton" text="+ Follow"
                            style="-fx-background-color: transparent; -fx-border-color: #D4AF37; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #D4AF37; -fx-font-size: 12px; -fx-padding: 5 16 5 16; -fx-cursor: hand;"/>
                    <Button text="Active"
                            style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #000000; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 16 5 16; -fx-cursor: hand;"/>
                    <Button text="Other"
                            style="-fx-background-color: transparent; -fx-border-color: #555555; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #888888; -fx-font-size: 12px; -fx-padding: 5 16 5 16; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Close Button (larger hit area) -->
            <Button text="&#x2715;" fx:id="closeButton"
                    style="-fx-background-color: #2A2A2A; -fx-border-color: #444444; -fx-border-radius: 50; -fx-background-radius: 50; -fx-text-fill: #CCCCCC; -fx-font-size: 15px; -fx-font-weight: bold; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40; -fx-cursor: hand;"/>
        </HBox>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: Left + Right columns              -->
        <!-- ═══════════════════════════════════════════════ -->
        <HBox spacing="0" style="-fx-background-color: #0A0A0A;">

            <!-- ─────────────────────────────────────────── -->
            <!-- LEFT COLUMN                                 -->
            <!-- ─────────────────────────────────────────── -->
            <VBox HBox.hgrow="ALWAYS" spacing="0"
                  style="-fx-padding: 20 16 20 20; -fx-background-color: #0A0A0A;">

                <!-- PRICE HISTORY CARD -->
                <VBox spacing="12"
                      style="-fx-background-color: #111111; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <HBox alignment="CENTER_LEFT" spacing="0">
                        <Label text="PRICE HISTORY"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                               HBox.hgrow="ALWAYS"/>
                        <!-- Day/Week/Month toggle; Month = active (gold) -->
                        <HBox spacing="4">
                            <Button fx:id="btnDay" text="Day"
                                    style="-fx-background-color: #222222; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
                            <Button fx:id="btnWeek" text="Week"
                                    style="-fx-background-color: #222222; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
                            <Button fx:id="btnMonth" text="Month"
                                    style="-fx-background-color: #FFD700; -fx-border-color: #FFD700; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #000000; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
                        </HBox>
                    </HBox>

                    <!-- LineChart: axes labelled with VND unit -->
                    <LineChart fx:id="priceHistoryChart" prefHeight="230"
                               animated="false" legendVisible="false"
                               style="-fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis fx:id="chartXAxis" label="Time"
                                          style="-fx-tick-label-fill: #888888; -fx-label-fill: #888888; -fx-tick-label-font-size: 10px;"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="chartYAxis" label="Price (VND)"
                                        style="-fx-tick-label-fill: #888888; -fx-label-fill: #888888; -fx-tick-label-font-size: 10px;"/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <Region prefHeight="16"/>

                <!-- SELLER INFORMATION CARD -->
                <VBox spacing="12"
                      style="-fx-background-color: #111111; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <Label text="Seller Information"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;"/>

                    <!-- Listed By -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Listed By:"
                               style="-fx-text-fill: #888888; -fx-font-size: 13px;"/>
                        <Label fx:id="sellerNameLabel" text="Myrle Oxnam"
                               style="-fx-text-fill: #D4AF37; -fx-font-weight: bold; -fx-font-size: 13px; -fx-underline: true; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Star rating (icon stars) + Contact button (outline gold) -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="&#9733;&#9733;&#9733;&#9733;&#9734;"
                               style="-fx-text-fill: #D4AF37; -fx-font-size: 15px;"/>
                        <Label fx:id="ratingLabel" text="4.6"
                               style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px;"/>
                        <Label text="|" style="-fx-text-fill: #333333; -fx-font-size: 13px;"/>
                        <Button text="&#x2709;  Contact"
                                style="-fx-background-color: transparent; -fx-border-color: #D4AF37; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #D4AF37; -fx-font-size: 12px; -fx-padding: 4 12 4 12; -fx-cursor: hand;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;"/>

                    <!-- Description with "Read more" -->
                    <VBox spacing="6">
                        <Label text="Description:"
                               style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
                        <Label fx:id="descriptionLabel"
                               text="Kobe Bryant Game Worn Jersey From Final NBA Opening Day 2015-2016 Season"
                               wrapText="true"
                               style="-fx-text-fill: #CCCCCC; -fx-font-size: 13px; -fx-line-spacing: 3;"/>
                        <Label text="Read more..."
                               style="-fx-text-fill: #D4AF37; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    </VBox>
                </VBox>

            </VBox>

            <!-- ─────────────────────────────────────────── -->
            <!-- RIGHT COLUMN                                -->
            <!-- ─────────────────────────────────────────── -->
            <VBox prefWidth="360" spacing="0"
                  style="-fx-padding: 20 20 20 4; -fx-background-color: #0A0A0A;">

                <!-- AUCTION KEY STATS CARD (gold border) -->
                <VBox spacing="14"
                      style="-fx-background-color: #111111; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #D4AF37; -fx-border-width: 1;">

                    <Label text="AUCTION KEY STATS"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;"/>
                    <Separator style="-fx-background-color: #2A2A2A; -fx-opacity: 1;"/>

                    <!-- Current Price (large, gold) -->
                    <VBox spacing="2">
                        <Label text="Current Price"
                               style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
                        <Label fx:id="currentPriceLabel" text="140,000 VND"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;"/>
                    </VBox>

                    <!-- Total Bids (hammer icon + own row) -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="&#128296;" style="-fx-font-size: 18px;"/>
                        <VBox spacing="1">
                            <Label text="Total Bids"
                                   style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
                            <Label fx:id="totalBidsLabel" text="0"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>

                    <!-- Start / End / Ends In (separated, readable) -->
                    <VBox spacing="8"
                          style="-fx-background-color: #1A1A1A; -fx-padding: 12; -fx-background-radius: 8;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="&#9654;  Start:"
                                   style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-min-width: 72;"/>
                            <Label fx:id="startTimeLabel" text="12/04/2026 10:00"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="&#9632;  End:"
                                   style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-min-width: 72;"/>
                            <Label fx:id="endTimeLabel" text="14/04/2026 10:00"
                                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;"/>
                        </HBox>
                        <Separator style="-fx-background-color: #333333; -fx-opacity: 1;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="&#9200;  Ends in:"
                                   style="-fx-text-fill: #888888; -fx-font-size: 12px; -fx-min-width: 72;"/>
                            <Label fx:id="endsInLabel" text="2d 14h 30m"
                                   style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <Region prefHeight="14"/>

                <!-- PRODUCT IMAGE (gold 2px border, shadow via background) -->
                <VBox spacing="0" alignment="CENTER"
                      style="-fx-background-color: #111111; -fx-padding: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #D4AF37; -fx-border-width: 2;">
                    <ImageView fx:id="productImageView"
                               fitWidth="300" fitHeight="300"
                               preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@add_Icon.png" backgroundLoading="true"/>
                        </image>
                    </ImageView>
                </VBox>

                <Region prefHeight="14"/>

                <!-- PLACE BID CARD -->
                <VBox spacing="10"
                      style="-fx-background-color: #111111; -fx-padding: 18; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #2A2A2A; -fx-border-width: 1;">

                    <Label text="Place Your Bid"
                           style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                    <!-- Input ~70%  |  Button ~30%, text BLACK for WCAG contrast -->
                    <HBox spacing="8" alignment="CENTER">
                        <TextField fx:id="bidInputField" promptText="Enter bid amount..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 10 12 10 12;"/>
                        <Button fx:id="placeBidButton" text="PLACE"
                                style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20 10 20; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Minimum bid hint -->
                    <Label fx:id="minBidLabel" text="Minimum bid: 140,500 VND"
                           style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
                </VBox>

            </VBox>
        </HBox>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- COMMENTS SECTION                                -->
        <!-- ═══════════════════════════════════════════════ -->
        <VBox spacing="14"
              style="-fx-background-color: #0D0D0D; -fx-padding: 20 20 24 20; -fx-border-color: #222222; -fx-border-width: 1 0 0 0;">

            <!-- Header: label + Newest/Oldest sort -->
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="COMMENTS"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"
                       HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="commentSortBox" value="Newest"
                          style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #CCCCCC; -fx-font-size: 12px;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Newest"/>
                            <String fx:value="Oldest"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <Separator style="-fx-background-color: #252525; -fx-opacity: 1;"/>

            <!-- Dynamic ListView (filled by controller) -->
            <ListView fx:id="commentsListView" prefHeight="180"
                      style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;"/>


            <!-- Comment input + POST (same style as Place Bid) -->
            <HBox spacing="8" alignment="CENTER"
                  style="-fx-padding: 4 0 0 0;">
                <TextField fx:id="commentInputField" promptText="Write a comment..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #1E1E1E; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 10 12 10 12;"/>
                <Button fx:id="postCommentButton" text="POST"
                        style="-fx-background-color: #D4AF37; -fx-border-color: #D4AF37; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20 10 20; -fx-cursor: hand;"/>
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>
