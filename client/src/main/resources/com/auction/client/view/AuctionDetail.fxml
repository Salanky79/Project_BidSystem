<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.1" fx:controller="com.auction.client.controller.AuctionDetailController">
    <Label style="-fx-font-size: 18;" text="Auction Detail" />
    <Label text="Item Name: Sample Item" />
    <Label text="Current Bid: $100" />
    <TextArea promptText="Add a comment" wrapText="true" />
    <Button mnemonicParsing="false" onAction="#handlePostComment" text="Post Comment" />
    <Button mnemonicParsing="false" onAction="#handleClose" text="Close" />
</VBox>

