<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<HBox maxHeight="600.0" maxWidth="950.0" minHeight="600.0" minWidth="950.0" prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.LoginController">

          <StackPane prefHeight="600" prefWidth="400" style="-fx-background-color: #0a0a0a;" HBox.hgrow="ALWAYS">

              <VBox alignment="CENTER" spacing="14" style="-fx-padding: 40 30 30 30;">
         <ImageView fitHeight="305.0" fitWidth="362.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@Logo.png" />
            </image>
         </ImageView>
             <Label style="-fx-font-size: 28px; -fx-font-weight: bold;                               -fx-text-fill: white; -fx-font-family: 'Arial Black';" text="WELCOME" />
             <Label style="-fx-font-size: 28px; -fx-font-weight: bold;                               -fx-text-fill: white; -fx-font-family: 'Arial Black';" text="TO" />

                  <!-- WELCOME TO -->
            <VBox alignment="CENTER" spacing="2" />

                  <!-- Heart + Brand name -->
            <HBox alignment="CENTER" spacing="10">
            <ImageView fitHeight="111.0" fitWidth="73.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@Logo2.png" />
               </image>
            </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 24px; -fx-text-fill: white;                                   -fx-font-family: Georgia; -fx-font-style: italic;" text="HanoiBid" />
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #c9a84c;" text="AUCTIONS" />
                    <Label style="-fx-font-size: 9px; -fx-text-fill: #c9a84c;" text="ESTB. 1744" />
                </VBox>
            </HBox>

                  <!-- Ornament -->
            <HBox alignment="CENTER" spacing="5">
                <Line endX="28.0" startX="0.0" stroke="#c9a84c" strokeWidth="1.0" />
                <Circle fill="#c9a84c" radius="1.5" />
                <Circle fill="#c9a84c" radius="2.5" />
                <Circle fill="#c9a84c" radius="4.0" />
                <Circle fill="#c9a84c" radius="2.5" />
                <Circle fill="#c9a84c" radius="1.5" />
                <Line endX="28.0" startX="0.0" stroke="#c9a84c" strokeWidth="1.0" />
            </HBox>

              </VBox>
    </StackPane>

          <!-- ===== RIGHT PANEL ===== -->
    <VBox prefHeight="600" prefWidth="500" spacing="0" style="-fx-background-color: #ffffff; -fx-padding: 24 40 40 40;" HBox.hgrow="ALWAYS">

              <!-- Top bar -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label style="-fx-font-size: 13px; -fx-text-fill: #666666;" text="Didn't have account ?" />
            <Button fx:id="signupBtn" onAction="#handleSignup" prefHeight="30.0" style="-fx-background-color: transparent;                            -fx-border-color: #1a1a1a;                            -fx-border-width: 1.5;                            -fx-border-radius: 5;                            -fx-background-radius: 5;                            -fx-font-size: 13px;                            -fx-padding: 5 16 5 16;                            -fx-cursor: hand;" text="Signup" />
        </HBox>

              <Region VBox.vgrow="ALWAYS" />

              <!-- Login title -->
        <Label style="-fx-font-size: 44px; -fx-font-weight: 300;                       -fx-text-fill: #1a1a1a; -fx-font-family: Georgia;                       -fx-padding: 0 0 20 0;" text="Login" />

              <!-- Username field -->
        <StackPane style="-fx-padding: 8 0 16 0;">
            <TextField fx:id="usernameField" prefHeight="52.0" style="-fx-background-color: white;                               -fx-border-color: #1a1a1a;                               -fx-border-width: 2;                               -fx-border-radius: 7;                               -fx-background-radius: 7;                               -fx-padding: 14 14 14 14;                               -fx-font-size: 14px;" />
            <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;                           -fx-background-color: white; -fx-padding: 0 4 0 4;" text="Username" translateX="14.0" translateY="-1.0" StackPane.alignment="TOP_LEFT" />
        </StackPane>

              <!-- Password field -->
        <StackPane style="-fx-padding: 8 0 6 0;">
            <PasswordField fx:id="passwordField" prefHeight="52.0" style="-fx-background-color: white;                                   -fx-border-color: #1a1a1a;                                   -fx-border-width: 2;                                   -fx-border-radius: 7;                                   -fx-background-radius: 7;                                   -fx-padding: 14 50 14 14;                                   -fx-font-size: 14px;" />
            <TextField fx:id="passwordVisible" prefHeight="52.0" style="-fx-background-color: white;                               -fx-border-color: #1a1a1a;                               -fx-border-width: 2;                               -fx-border-radius: 7;                               -fx-background-radius: 7;                               -fx-padding: 14 50 14 14;                               -fx-font-size: 14px;" visible="false" />
            <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;                           -fx-background-color: white; -fx-padding: 0 4 0 4;" text="Password" translateX="14.0" translateY="-1.0" StackPane.alignment="TOP_LEFT" />

                  <Button fx:id="eyeToggleBtn" onAction="#togglePassword" style="-fx-background-color: transparent;                            -fx-border-color: transparent;                            -fx-font-size: 16px;                            -fx-cursor: hand;                            -fx-padding: 0;" text="👁" translateX="-14.0" StackPane.alignment="CENTER_RIGHT" />
        </StackPane>

              <!-- Error label -->
        <Label fx:id="errorLabel" style="-fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-padding: 4 0 4 0;" text="" visible="false" />

              <!-- Footer -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 0 0 0;">
            <Button style="-fx-background-color: transparent;                            -fx-border-color: transparent;                            -fx-text-fill: #888888;                            -fx-font-size: 13px;                            -fx-cursor: hand;" text="Forgot Password?" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="loginBtn" onAction="#handleLogin" prefHeight="44.0" prefWidth="110.0" style="-fx-background-color: #1a1a1a;                            -fx-text-fill: white;                            -fx-font-size: 15px;                            -fx-font-weight: bold;                            -fx-border-radius: 7;                            -fx-background-radius: 7;                            -fx-cursor: hand;" text="Login" />
        </HBox>

              <Region VBox.vgrow="ALWAYS" />

          </VBox>

</HBox>
