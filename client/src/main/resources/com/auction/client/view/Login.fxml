<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Polygon?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.LoginController"
      prefWidth="900.0"
      prefHeight="600.0"
      style="-fx-background-color: #ffffff;">

    <StackPane prefWidth="400" prefHeight="600"
               style="-fx-background-color: #0a0a0a;">

        <VBox alignment="CENTER" spacing="14"
              style="-fx-padding: 40 30 30 30;">

            <!-- Gold ribbon -->
            <StackPane prefWidth="36" prefHeight="64" VBox.vgrow="NEVER">
                <Rectangle width="36.0" height="50.0"
                           fill="#c9a84c"
                           StackPane.alignment="TOP_CENTER"/>
                <Polygon points="0.0,0.0,36.0,0.0,18.0,14.0"
                         fill="#0a0a0a"
                         StackPane.alignment="BOTTOM_CENTER"/>
            </StackPane>

            <!-- WELCOME TO -->
            <VBox alignment="CENTER" spacing="2">
                <Label text="WELCOME"
                       style="-fx-font-size: 28px; -fx-font-weight: bold;
                              -fx-text-fill: white; -fx-font-family: 'Arial Black';"/>
                <Label text="TO"
                       style="-fx-font-size: 28px; -fx-font-weight: bold;
                              -fx-text-fill: white; -fx-font-family: 'Arial Black';"/>
            </VBox>

            <!-- Heart + Brand name -->
            <HBox alignment="CENTER" spacing="10">
                <Label text="♥"
                       style="-fx-font-size: 64px; -fx-text-fill: #c9a84c;"/>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Sothebuy's"
                           style="-fx-font-size: 24px; -fx-text-fill: white;
                                  -fx-font-family: Georgia; -fx-font-style: italic;"/>
                    <Label text="AUCTIONS"
                           style="-fx-font-size: 10px; -fx-text-fill: #c9a84c;"/>
                    <Label text="ESTB. 1744"
                           style="-fx-font-size: 9px; -fx-text-fill: #c9a84c;"/>
                </VBox>
            </HBox>

            <!-- Ornament -->
            <HBox alignment="CENTER" spacing="5">
                <Line startX="0.0" endX="28.0" stroke="#c9a84c" strokeWidth="1.0"/>
                <Circle radius="1.5" fill="#c9a84c"/>
                <Circle radius="2.5" fill="#c9a84c"/>
                <Circle radius="4.0" fill="#c9a84c"/>
                <Circle radius="2.5" fill="#c9a84c"/>
                <Circle radius="1.5" fill="#c9a84c"/>
                <Line startX="0.0" endX="28.0" stroke="#c9a84c" strokeWidth="1.0"/>
            </HBox>

        </VBox>
    </StackPane>

    <!-- ===== RIGHT PANEL ===== -->
    <VBox prefWidth="500" prefHeight="600"
          style="-fx-background-color: #ffffff; -fx-padding: 24 40 40 40;"
          spacing="0">

        <!-- Top bar -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label text="Didn't have account ?"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
            <Button text="Signup"
                    fx:id="signupBtn"

                    prefHeight="30.0"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #1a1a1a;
                           -fx-border-width: 1.5;
                           -fx-border-radius: 5;
                           -fx-background-radius: 5;
                           -fx-font-size: 13px;
                           -fx-padding: 5 16 5 16;
                           -fx-cursor: hand;"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Login title -->
        <Label text="Login"
               style="-fx-font-size: 44px; -fx-font-weight: 300;
                      -fx-text-fill: #1a1a1a; -fx-font-family: Georgia;
                      -fx-padding: 0 0 20 0;"/>

        <!-- Username field -->
        <StackPane style="-fx-padding: 8 0 16 0;">
            <TextField fx:id="usernameField"
                       prefHeight="52.0"
                       style="-fx-background-color: white;
                              -fx-border-color: #1a1a1a;
                              -fx-border-width: 2;
                              -fx-border-radius: 7;
                              -fx-background-radius: 7;
                              -fx-padding: 14 14 14 14;
                              -fx-font-size: 14px;"/>
            <Label text="Username"
                   style="-fx-font-size: 11px; -fx-text-fill: #888888;
                          -fx-background-color: white; -fx-padding: 0 4 0 4;"
                   StackPane.alignment="TOP_LEFT"
                   translateX="14.0"
                   translateY="-1.0"/>
        </StackPane>

        <!-- Password field -->
        <StackPane style="-fx-padding: 8 0 6 0;">
            <PasswordField fx:id="passwordField"
                           prefHeight="52.0"
                           style="-fx-background-color: white;
                                  -fx-border-color: #1a1a1a;
                                  -fx-border-width: 2;
                                  -fx-border-radius: 7;
                                  -fx-background-radius: 7;
                                  -fx-padding: 14 50 14 14;
                                  -fx-font-size: 14px;"/>
            <TextField fx:id="passwordVisible"
                       prefHeight="52.0"
                       visible="false"
                       style="-fx-background-color: white;
                              -fx-border-color: #1a1a1a;
                              -fx-border-width: 2;
                              -fx-border-radius: 7;
                              -fx-background-radius: 7;
                              -fx-padding: 14 50 14 14;
                              -fx-font-size: 14px;"/>
            <Label text="Password"
                   style="-fx-font-size: 11px; -fx-text-fill: #888888;
                          -fx-background-color: white; -fx-padding: 0 4 0 4;"
                   StackPane.alignment="TOP_LEFT"
                   translateX="14.0"
                   translateY="-1.0"/>

            <Button fx:id="eyeToggleBtn"
                    text="👁"
                    onAction="#togglePassword"
                    style="-fx-background-color: transparent;
                           -fx-border-color: transparent;
                           -fx-font-size: 16px;
                           -fx-cursor: hand;
                           -fx-padding: 0;"
                    StackPane.alignment="CENTER_RIGHT"
                    translateX="-14.0"/>
        </StackPane>

        <!-- Error label -->
        <Label fx:id="errorLabel"
               text=""
               visible="false"
               style="-fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-padding: 4 0 4 0;"/>

        <!-- Footer -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 0 0 0;">
            <Button text="Forgot Password?"

                    style="-fx-background-color: transparent;
                           -fx-border-color: transparent;
                           -fx-text-fill: #888888;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Login"
                    fx:id="loginBtn"
                    onAction="#handleLogin"
                    prefWidth="110.0"
                    prefHeight="44.0"
                    style="-fx-background-color: #1a1a1a;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;
                           -fx-border-radius: 7;
                           -fx-background-radius: 7;
                           -fx-cursor: hand;"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

    </VBox>

</HBox>
