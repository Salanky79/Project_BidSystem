<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.1" fx:controller="com.auction.client.controller.LoginController">
    <Label style="-fx-font-size: 24;" text="Auction System Login" />
    <TextField promptText="Username" />
    <PasswordField promptText="Password" />
    <Button mnemonicParsing="false" onAction="#handleLogin" style="-fx-font-size: 14;" text="Login" />
</VBox>

