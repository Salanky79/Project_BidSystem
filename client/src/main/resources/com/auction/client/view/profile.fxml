<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.VBox?>
<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.ProfileController">
    <children>
        <Label fx:id="nameLabel" layoutX="155.0" layoutY="40.0" prefHeight="56.0" prefWidth="501.0" text="Ahmed Abdullah" textFill="#1a1a1a">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Label>

        <Button fx:id="editButton" layoutX="727.0" layoutY="50.0" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Edit Profile" />

        <GridPane hgap="30.0" layoutX="155.0" layoutY="140.0" prefWidth="700.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <VBox spacing="5.0">
                    <Label text="Name" textFill="#888888" />
                    <TextField fx:id="nameField" editable="false" prefHeight="45.0" style="-fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" text="Ahmed Abdullah" />
                </VBox>
                <VBox spacing="5.0" GridPane.columnIndex="1">
                    <Label text="Username" textFill="#888888" />
                    <TextField fx:id="usernameField" editable="false" prefHeight="45.0" style="-fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" text="ahmedivy" />
                </VBox>
                <VBox spacing="5.0" GridPane.rowIndex="1">
                    <Label text="Email" textFill="#888888" />
                    <TextField fx:id="emailField" editable="false" prefHeight="45.0" style="-fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" text="ahmad@gmail.com" />
                </VBox>
                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Phone Number" textFill="#888888" />
                    <TextField fx:id="phoneField" editable="false" prefHeight="45.0" style="-fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;" text="03179947486" />
                </VBox>
            </children>
        </GridPane>

        <Label layoutX="155.0" layoutY="350.0" text="Auction History" textFill="#1a1a1a">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TableView fx:id="table" layoutX="155.0" layoutY="390.0" prefHeight="250.0" prefWidth="700.0" style="-fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8;">
            <columns>
                <TableColumn fx:id="colItem" prefWidth="250.0" text="Item" />
                <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                <TableColumn fx:id="colBid" prefWidth="150.0" text="Your Bid" />
                <TableColumn fx:id="colTime" prefWidth="148.0" text="Time" />
            </columns>
        </TableView>
    </children>
</AnchorPane>