<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="0"
      style="-fx-background-color: #f0f0f0; -fx-padding: 24 24 24 24;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.SellerDashboardController">

    <!-- ===== TITLE ===== -->
    <Label text="Seller Dashboard"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a; -fx-font-family: Georgia;">
        <VBox.margin><Insets bottom="16"/></VBox.margin>
    </Label>

    <!-- ===== 4 STAT BOXES ===== -->
    <HBox spacing="16" fillHeight="true">
        <VBox.margin><Insets bottom="24"/></VBox.margin>

        <!-- Total Revenue -->
        <VBox fx:id="boxRevenue" spacing="8"
              style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);
                     -fx-padding: 20 24 20 24;"
              HBox.hgrow="ALWAYS">
            <Label text="Total Revenue"
                   style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
            <Label fx:id="labelRevenue"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        </VBox>

        <!-- Active Auctions -->
        <VBox fx:id="boxActive" spacing="8"
              style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);
                     -fx-padding: 20 24 20 24;"
              HBox.hgrow="ALWAYS">
            <Label text="Active Auctions"
                   style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
            <Label fx:id="labelActive" text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        </VBox>

        <!-- Completed Sales -->
        <VBox fx:id="boxCompleted" spacing="8"
              style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);
                     -fx-padding: 20 24 20 24;"
              HBox.hgrow="ALWAYS">
            <Label text="Completed Sales"
                   style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
            <Label fx:id="labelCompleted" text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        </VBox>

        <!-- Awaiting Shipment -->
        <VBox fx:id="boxShipment" spacing="8"
              style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);
                     -fx-padding: 20 24 20 24;"
              HBox.hgrow="ALWAYS">
            <Label text="Awaiting Shipment"
                   style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
            <Label fx:id="labelShipment" text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
        </VBox>

    </HBox>

    <!-- ===== FILTER BAR + MANAGE BUTTON ===== -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox.margin><Insets bottom="16"/></VBox.margin>

        <!-- Status filter -->
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Status:"
                   style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>
            <Button fx:id="btnFilterAll" text="All"
                    onAction="#handleFilterAll"
                    style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand;"/>
            <Label text="/"
                   style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;"/>
            <Button fx:id="btnFilterActive" text="Active"
                    onAction="#handleFilterActive"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand; -fx-border-color: #cccccc; -fx-border-width: 1;"/>
            <Label text="/"
                   style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;"/>
            <Button fx:id="btnFilterEnded" text="Ended"
                    onAction="#handleFilterEnded"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand; -fx-border-color: #cccccc; -fx-border-width: 1;"/>
        </HBox>

        <!-- Date filter -->
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Date:"
                   style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>
            <Button fx:id="btnDateMonth" text="This Month"
                    onAction="#handleDateMonth"
                    style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand;"/>
            <Label text="/"
                   style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;"/>
            <Button fx:id="btnDate7Days" text="Last 7 Days"
                    onAction="#handleDate7Days"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand; -fx-border-color: #cccccc; -fx-border-width: 1;"/>
        </HBox>

        <!-- Spacer -->
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Manage button -->
        <Button fx:id="btnManage" text="Manage"
                onAction="#handleManage"
                style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-border-radius: 8; -fx-background-radius: 8;
                       -fx-padding: 8 20 8 20; -fx-cursor: hand;"/>
    </HBox>

    <!-- ===== AUCTION CARD GRID ===== -->
    <GridPane fx:id="auctionGrid" hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
        </columnConstraints>
    </GridPane>

</VBox>
