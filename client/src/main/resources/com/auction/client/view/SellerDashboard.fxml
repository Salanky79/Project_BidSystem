<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="0"
      style="-fx-background-color: #f0f0f0; -fx-padding: 24 24 24 24;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.SellerDashboardController">

    <!-- ===== TITLE ===== -->
    <Label text="Seller Dashboard"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a; -fx-font-family: Georgia;">
        <VBox.margin><Insets bottom="16"/></VBox.margin>
    </Label>



    <!-- ===== FILTER BAR + MANAGE BUTTON ===== -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox.margin><Insets bottom="16"/></VBox.margin>

        <!-- Status filter -->
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Status:"
                   style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>
            <Button fx:id="btnFilterAll" text="All"
                    onAction="#handleFilterAll"
                    style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand;"/>
            <Label text="/"
                   style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;"/>
            <Button fx:id="btnFilterActive" text="Active"
                    onAction="#handleFilterActive"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand; -fx-border-color: #cccccc; -fx-border-width: 1;"/>
            <Label text="/"
                   style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;"/>
            <Button fx:id="btnFilterEnded" text="Ended"
                    onAction="#handleFilterEnded"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand; -fx-border-color: #cccccc; -fx-border-width: 1;"/>
        </HBox>

        <!-- Date filter -->
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Date:"
                   style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>
            <Button fx:id="btnDateMonth" text="This Month"
                    onAction="#handleDateMonth"
                    style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand;"/>
            <Label text="/"
                   style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;"/>
            <Button fx:id="btnDate7Days" text="Last 7 Days"
                    onAction="#handleDate7Days"
                    style="-fx-background-color: transparent; -fx-text-fill: #555555;
                           -fx-font-size: 12px; -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 4 12 4 12; -fx-cursor: hand; -fx-border-color: #cccccc; -fx-border-width: 1;"/>
        </HBox>

        <!-- Spacer -->
        <Region HBox.hgrow="ALWAYS"/>

    </HBox>

    <!-- ===== AUCTION CARD GRID ===== -->
    <GridPane fx:id="auctionGrid" hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
        </columnConstraints>
    </GridPane>

</VBox>
